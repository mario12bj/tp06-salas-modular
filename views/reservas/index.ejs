<link rel="stylesheet" href="/public/css/estilos.css">
<h1>Listado de Reservas</h1>


<% if (reservas.length === 0) { %>
  <p>No hay reservas cargadas actualmente.</p>
<% } else { %>
  <ul>
    <% reservas.forEach(r => { %>
      <li>
        <strong><%= r.estudiante %></strong> - <%= r.sala %> (<%= r.fecha %> - <%= r.turno %>)
        <a href="/reservas/<%= r.id %>">Ver detalle</a>
      </li>
    <% }) %>
  </ul>
<% } %>
<a href="/reservas/nueva">Nueva Reserva</a>