<h1>Nueva Reserva</h1>

<% if (errores && errores.length > 0) { %>
  <div role="alert" style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 10px;">
    <ul>
      <% errores.forEach(err => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/reservas" method="POST">
  <div>
    <label for="estudiante">Estudiante:</label>
    <input type="text" id="estudiante" name="estudiante" value="<%= datos.estudiante || '' %>">
  </div>
  <div>
    <label for="email">Email:</label>
    <input type="text" id="email" name="email" value="<%= datos.email || '' %>">
  </div>
  <div>
    <label for="sala">Sala:</label>
    <select id="sala" name="sala">
      <% salasPermitidas.forEach(s => { %>
        <option value="<%= s %>" <%= datos.sala === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="fecha">Fecha:</label>
    <input type="date" id="fecha" name="fecha" value="<%= datos.fecha || '' %>">
  </div>
  <div>
    <label for="turno">Turno:</label>
    <select id="turno" name="turno">
      <option value="Mañana" <%= datos.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
      <option value="Tarde" <%= datos.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
      <option value="Noche" <%= datos.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
    </select>
  </div>
  <div>
    <label for="personas">Cantidad de personas:</label>
    <input type="number" id="personas" name="personas" value="<%= datos.personas || '' %>">
  </div>
  <button type="submit">Reservar</button>
</form>